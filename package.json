{
  "name": "music-db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --mode development && concurrently \"vite build --watch --mode development\" \"wrangler pages dev dist --port 8788\"",
    "build": "vite build",
    "deploy": "npm run build && wrangler pages deploy dist",
    "db:schema": "wrangler d1 execute musicvixenj --local --file=schema.sql",
    "db:seed": "wrangler d1 execute musicvixenj --local --file=seed.sql",
    "db:schema:remote": "wrangler d1 execute musicvixenj --remote --file=schema.sql",
    "db:seed:remote": "wrangler d1 execute musicvixenj --remote --file=seed.sql"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "pdfjs-dist": "^4.9.155",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^6.0.3",
    "wrangler": "^4.72.0"
  }
}
